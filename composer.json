{
    "name": "trollbus/symfony-messenger-bridge",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kenny1911",
            "email": "o-muzyka@mail.ru"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs-fix": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs-check": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer check",
        "phpunit": "phpunit",
        "phpstan": [
            "./tools/phpstan/vendor/bin/phpstan clear-result-cache",
            "./tools/phpstan/vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "checks": [
            "@cs-check",
            "@phpunit",
            "@phpstan"
        ]
    },
    "autoload": {
        "psr-4": {
            "Trollbus\\SymfonyMessengerBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trollbus\\Tests\\SymfonyMessengerBridge\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.4 || ^8.0",
        "trollbus/message": "^0.3.2",
        "trollbus/message-bus": "^0.3.2",
        "trollbus/trollbus-bundle": "^0.3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    }
}
